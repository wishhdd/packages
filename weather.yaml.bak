#########
input_number:
  forecast_temp_09:
    name: Прогноз температуры на 9
    min: -50
    max: 50
    step: 0.1
    icon: mdi:thermometer
  forecast_temp_13:
    name: Прогноз температуры на 13
    min: -50
    max: 50
    step: 0.1
    icon: mdi:thermometer
  forecast_temp_17:
    name: Прогноз температуры на 17
    min: -50
    max: 50
    step: 0.1
    icon: mdi:thermometer
  forecast_temp_21:
    name: Прогноз температуры на 21
    min: -50
    max: 50
    step: 0.1
    icon: mdi:thermometer
  forecast_temp_23:
    name: Прогноз температуры на 23
    min: -50
    max: 50
    step: 0.1
    icon: mdi:thermometer

input_text:
  forecast_condition_09:
    name: Прогноз состояния на 9
    max: 255
    icon: mdi:weather-cloudy
  forecast_condition_13:
    name: Прогноз состояния на 13
    max: 255
    icon: mdi:weather-cloudy
  forecast_condition_17:
    name: Прогноз состояния на 17
    max: 255
    icon: mdi:weather-cloudy
  forecast_condition_21:
    name: Прогноз состояния на 21
    max: 255
    icon: mdi:weather-cloudy
  forecast_condition_23:
    name: Прогноз состояния на 23
    max: 255
    icon: mdi:weather-cloudy

#########
script:
  weather_report:
    alias: "Отчет о погоде"
    sequence:
      - choose:
          - conditions:
              - condition: template
                value_template: "{{ states('weather.yandexweather') not in ['unknown', 'unavailable'] }}"
            sequence:
              - service: weather.get_forecasts
                target:
                  entity_id: weather.yandexweather
                data:
                  type: hourly
                response_variable: hourly_forecast
              - service: notify.telegram
                data:
                  title: "Прогноз погоды."
                  message: |
                    {%- set weather_entity = 'weather.yandexweather' -%}
                    {%- set bearing = state_attr(weather_entity, 'wind_bearing') -%}
                    {%- set directions = ['Северный', 'Северо-восточный', 'Восточный', 'Юго-восточный', 'Южный', 'Юго-западный', 'Западный', 'Северо-западный', 'Северный'] -%}
                    {%- set wind_direction = directions[((bearing + 22.5) / 45) | int] if bearing is not none else '' -%}
                    {%- set translations = {
                      "clear": "Ясно", "sunny": "Солнечно", "cloudy": "Облачно", "overcast": "Пасмурно",
                      "partly-cloudy": "Переменная облачность", "rain": "Дождь", "light-rain": "Небольшой дождь",
                      "heavy-rain": "Сильный дождь", "showers": "Ливень", "wet-snow": "Мокрый снег",
                      "light-snow": "Небольшой снег", "snow": "Снег", "snow-showers": "Снегопад", "hail": "Град",
                      "thunderstorm": "Гроза", "thunderstorm-with-rain": "Дождь с грозой", "thunderstorm-with-hail": "Гроза с градом"
                    } -%}
                    {%- set current_condition_key = state_attr(weather_entity, 'yandex_condition') | lower -%}
                    {%- set yandex_condition_ru = translations[current_condition_key] | default(current_condition_key | capitalize) -%}
                    За окном: *{{ yandex_condition_ru }}*.
                    🌡️ Температура: *{{ state_attr(weather_entity, 'temperature') | default('N/A') }}°C *
                    {%- if state_attr(weather_entity, 'feels_like') is not none -%}
                    (ощущается как *{{ state_attr(weather_entity, 'feels_like') }}°C*)
                    {%- endif -%}
                    .
                    🌬️ Ветер: *{{ wind_direction }} {{ state_attr(weather_entity, 'wind_speed') | default('N/A') }} м/с.*

                    *Прогноз на день:*
                      {% if hourly_forecast[weather_entity] is defined and hourly_forecast[weather_entity].forecast | length > 0 %}
                      {%- set forecast_data = namespace(morning=none, day=none, late_afternoon=none, evening=none, late_evening=none) -%}
                      {%- for hour in hourly_forecast[weather_entity].forecast -%}
                        {%- set hour_num = (hour.datetime | as_datetime | as_local).hour -%}
                        {%- if hour_num == 9 and forecast_data.morning == none -%}
                          {%- set forecast_data.morning = "🌅 Утром (09:00): *%s°C*, %s" | format(hour.temperature, translations[hour.condition | lower] | default(hour.condition | capitalize)) -%}
                        {%- elif hour_num == 13 and forecast_data.day == none -%}
                          {%- set forecast_data.day = "☀️ Днем (13:00): *%s°C*, %s" | format(hour.temperature, translations[hour.condition | lower] | default(hour.condition | capitalize)) -%}
                        {%- elif hour_num == 17 and forecast_data.late_afternoon == none -%}
                          {%- set forecast_data.late_afternoon = "🌆 К вечеру (17:00): *%s°C*, %s" | format(hour.temperature, translations[hour.condition | lower] | default(hour.condition | capitalize)) -%}
                        {%- elif hour_num == 21 and forecast_data.evening == none -%}
                          {%- set forecast_data.evening = "🌃 Вечером (21:00): *%s°C*, %s" | format(hour.temperature, translations[hour.condition | lower] | default(hour.condition | capitalize)) -%}
                        {%- elif hour_num == 23 and forecast_data.late_evening == none -%}
                          {%- set forecast_data.late_evening = "🌙 Ночью (23:00): *%s°C*, %s" | format(hour.temperature, translations[hour.condition | lower] | default(hour.condition | capitalize)) -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {{ forecast_data.morning or 'Прогноз на 09:00 недоступен.' }}
                      {{ forecast_data.day or 'Прогноз на 13:00 недоступен.' }}
                      {{ forecast_data.late_afternoon or 'Прогноз на 17:00 недоступен.' }}
                      {{ forecast_data.evening or 'Прогноз на 21:00 недоступен.' }}
                      {{ forecast_data.late_evening or 'Прогноз на 23:00 недоступен.' }}
                    {%- else -%}
                      Не удалось получить детальный прогноз на день.
                    {%- endif %}
                  data:
                    parse_mode: markdown
        default:
          - service: notify.telegram
            data:
              message: "Не удалось получить прогноз погоды. Сервис недоступен."
